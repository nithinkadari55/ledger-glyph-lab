// expect-none
#set page(paper: "a3", margin: 3cm)
#set text(size: 16pt, lang: "en", hyphenate: true)
#text(size: 60pt, weight: "bold")[City Jazz Week]

#block(width: 11cm)[
  Four nights of music fill the old harbour district with swing, soul and
  improvisation, from candlelit club sets to late concerts on the waterfront stages.

  Internationally celebrated headliners share the programme with neighbourhood
  ensembles, student orchestras and unannounced collaborations after midnight.

  Doors open every evening at half past six sharp.
]

#block(width: 11cm)[
  #set par(leading: 0.8em)
  Tickets for every evening are sold at the harbour office and at the door
  #v(8pt, weak: true)
  #text(size: 12pt)[Sunday is free.]
]
